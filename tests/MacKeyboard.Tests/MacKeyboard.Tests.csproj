<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Targets plain net10.0, not net10.0-windows, so the remapper's behaviour can be verified on
    macOS. This is the only automated check that exists for the sticky-modifier bug — the machine
    the program actually runs on is not available here.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/MacKeyboard.Core/MacKeyboard.Core.csproj" />
  </ItemGroup>

</Project>
